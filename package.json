{
  "name": "mixdown-report",
  "version": "1.1.0",
  "description": "Browser app that analyzes a Logic Pro bounce and recommends mix and mastering fixes using Logic's built-in plugins.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test",
    "predeploy": "npm run verify",
    "deploy": "netlify deploy --prod --dir=src",
    "pst": "node scripts/pst.js",
    "calibration": "node scripts/calibration.js",
    "images": "node scripts/social-images.js"
  }
}
